# Application
NODE_ENV=development
PORT=3000
# Hops allowed to set X-Forwarded-For (Express `trust proxy`): the BFF forwards
# the browser's address, and the auth rate limit counts per that address.
# `1` trusts the direct caller — right only while the API is reachable solely
# through the BFF (locally, Docker Desktop hands published-port traffic to the
# API from an address that is not the BFF's, so a subnet cannot single it out).
# Where the BFF's address is known, list it instead (e.g. `10.0.3.0/24`).
# Empty = trust nobody: every browser shares the BFF's budget.
TRUST_PROXY=1

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO for local development)
STORAGE_ENDPOINT=http://minio:9000
# Host the browser uses to reach the storage (MinIO's published port on the host)
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_RAW_BUCKET=streamtube-raw
STORAGE_PROCESSED_BUCKET=streamtube-processed
STORAGE_UPLOAD_URL_TTL_SECONDS=600
STORAGE_PLAYBACK_URL_TTL_SECONDS=300

# Background queue (pg-boss, on the same PostgreSQL instance)
QUEUE_SCHEMA=pgboss
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_EXPIRE_IN_SECONDS=3600
