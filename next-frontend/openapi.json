  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Original file name — only used to derive the storage key",
            "example": "clip.mp4"
          },
          "content_type": {
            "type": "string",
            "description": "MIME type of the upload; must be a `video/*` type",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "description": "Total size of the file in bytes (max 10 GiB)",
            "example": 52428800,
            "minimum": 1
          },
          "part_size_bytes": {
            "type": "number",
            "description": "Desired part size in bytes; at least 5242880 (5 MiB), the S3 minimum for every part but the last",
            "example": 67108864,
            "minimum": 5242880
          }
        },
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ]
      },
      "PresignPartsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "description": "Part numbers to presign. On resume, send only the parts still missing.",
            "example": [
              1,
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "description": "1-based part number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "description": "ETag returned by the storage for that part",
            "example": "\"9b2cf5f1e6c1f0b0b1a2c3d4e5f60718\""
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "Every uploaded part with the ETag the storage returned",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}